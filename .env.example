# ==============================================================================
# Q-Trace Environment Configuration Template
# Copy this file to .env before starting the services.
# NEVER commit .env or any file containing real API keys or credentials.
# ==============================================================================

# API and Web Service URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB Atlas / Local fallback)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=qtrace_dev

# AI Pedagogy & Tutor Service
# Supported providers: mock | openai | anthropic | gemini
TUTOR_PROVIDER=mock
TUTOR_MODEL=mock-tutor-v1
TUTOR_API_KEY=

# Feature and Reliability Flags (1 = enabled, 0 = disabled)
DEMO_LOCAL=1
DEMO_FALLBACK=1
ENABLE_PENNYLANE=1
ENABLE_CODE_PARSE=1
ENABLE_TUTOR_CLOUD=0
ENABLE_NOISE_LAB=0
