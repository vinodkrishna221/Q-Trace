# ==============================================================================
# Q-Trace Production Environment Configuration Template (SHIP-4)
# ==============================================================================
# Template for cloud staging and production environments (Vercel + Railway + Atlas).
# Use this to configure environment variables in Vercel and Railway dashboard settings.
# NEVER commit real credentials, production connection strings, or API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Service (Vercel Project: qtrace-web)
# ------------------------------------------------------------------------------
# Base URL pointing to the deployed backend API on Railway.
NEXT_PUBLIC_API_BASE_URL=https://qtrace-api.up.railway.app

# ------------------------------------------------------------------------------
# Backend API Service (Railway Service: qtrace-api)
# ------------------------------------------------------------------------------
# Allowed origin for CORS (matches deployed frontend on Vercel).
WEB_ORIGIN=https://qtrace-web.vercel.app
APP_URL=https://qtrace-web.vercel.app
ENVIRONMENT=production
SECURE_COOKIES=1

# Execution port (provided dynamically by Railway via $PORT)
PORT=8000

# ------------------------------------------------------------------------------
# Authentication & Identity Configuration (Argon2id + PyJWT + 2FA + OAuth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_random_64_char_hex_key_for_production_jwt_signing

# Transactional Email Dispatch (Resend API)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_live_resend_api_key_here
SENDER_EMAIL=Q-Trace <onboarding@resend.dev>

# GitHub OAuth 2.0 (Optional - for 1-Click developer login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://qtrace-api.up.railway.app/v1/auth/github/callback

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas M0 Cluster)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
# Network access in Atlas must allow Railway outbound IPs (0.0.0.0/0 recommended for hackathon).
MONGODB_URI=mongodb+srv://qtrace_admin:<PASSWORD>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=qtrace_prod

# ------------------------------------------------------------------------------
# Reliability & Feature Flags
# ------------------------------------------------------------------------------
# DEMO_LOCAL=0 engages the Atlas MongoDB repository; set to 1 for venue fallback.
DEMO_LOCAL=0

# DEMO_FALLBACK=1 ensures curated trace-aware fallback is active if cloud LLM fails.
DEMO_FALLBACK=1

# Execution timeout budget in seconds (strict contract: <= 2.0s).
QTRACE_SIM_TIMEOUT_S=1.5

# Quantum runtime adapters
ENABLE_QISKIT=1
ENABLE_PENNYLANE=1
ENABLE_CODE_PARSE=1
ENABLE_NOISE_LAB=0

# ------------------------------------------------------------------------------
# AI Pedagogy & Cloud Tutor (Optional - Mock active by default)
# ------------------------------------------------------------------------------
# Supported providers: mock | openai | anthropic | gemini | openrouter | cloud
ENABLE_TUTOR_CLOUD=1
DEMO_FALLBACK=0
TUTOR_PROVIDER=openrouter
TUTOR_MODEL=inclusionai/ling-3.0-flash-vl:free
TUTOR_API_KEY=
TUTOR_TIMEOUT_SECONDS=25.0
TUTOR_STRUCTURED_OUTPUTS=0

